# Copie para .env e preencha. O arquivo .env NÃO é versionado.

# DataJud (CNJ) — chave pública divulgada pelo CNJ, sujeita a troca.
# Copie o valor atual em: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=

# Fontes privadas (opcionais) para busca por nome/CPF/CNPJ/OAB.
# Judit — https://docs.judit.io  (header api-key)
JUDIT_API_KEY=
# Escavador — https://api.escavador.com/v2/docs/  (Bearer token)
ESCAVADOR_TOKEN=

# Pasta com os PDFs/DOCX do escritório (um subdiretório por processo)
LR_DOCS=data/documentos
